# Salin ke /srv/presensi/backend/.env lalu isi nilainya.
# Berkas ini masuk .gitignore — jangan commit yang asli.

# Wajib. Backend berhenti kalau kosong (index.js baris 54).
MONGODB_URI=mongodb://127.0.0.1:27017/presensi

# Harus cocok dengan proxy_pass di presensi.conf.
PORT=5000

# Folder foto absensi. Kalau tidak diisi, default-nya
# <repo backend>/uploads — ikut di dalam repo, jadi rawan
# tertimpa atau terhapus saat deploy. Isi dengan path di luar
# repo seperti di bawah ini.
UPLOAD_DIR=/srv/presensi/uploads

# =========================================================
# REKAP UNTUK PETUGAS
# =========================================================

# Nomor WhatsApp petugas yang boleh melihat dan mengunduh
# rekap absensi seluruh pegawai, dipisah koma. Boleh format
# 08… maupun 62… — keduanya dinormalkan.
#
# KOSONG BERARTI TIDAK ADA YANG BOLEH. Ini disengaja: daftar
# kosong yang diartikan "semua boleh" akan membuka data satu
# biro tanpa ada yang menyadarinya.
PETUGAS_ABSENSI=6281234567890,6289876543210

# Alamat dasar untuk tautan foto di dalam berkas Excel saja.
# WAJIB lengkap dengan nomor port — tanpa :8001 tautannya
# menunjuk ke port 80 yang di VPS ini milik aplikasi lain.
# Halaman rekap di web tidak memakai nilai ini; fotonya
# dipanggil dengan path relatif dari origin yang sama.
PUBLIC_BASE_URL=http://192.168.221.44:8001

# Alamat yang didengarkan backend. Bawaannya 127.0.0.1, jadi
# hanya nginx (dan bot SisKA di VPS yang sama) yang bisa
# menjangkaunya. Isi "0.0.0.0" hanya untuk penelusuran masalah
# — itu membuka seluruh API ke jaringan tanpa melewati nginx.
HOST=127.0.0.1

# =========================================================
# BATAS RADIUS ABSENSI WFO
# =========================================================

# off | warn | enforce. Bawaannya off — tidak ada yang berubah
# sampai diisi. Mulai dari "warn" satu-dua minggu, jalankan
# scripts/analisa-radius.js, baru pindah ke "enforce".
RADIUS_MODE=off

# Koordinat Kantor Kementerian Ketenagakerjaan RI,
# Jl. Taman Patra 13, Kuningan Timur, Setiabudi, Jakarta
# Selatan. Dicocokkan lewat reverse geocoding OpenStreetMap.
KANTOR_LAT=-6.236990
KANTOR_LNG=106.830554

# Radius dalam meter. Jangan terlalu ketat: GPS ponsel di
# dalam gedung beton biasa meleset 20-50 meter.
#
# 500 m cukup longgar — meliputi area sekitar 78 hektar, jadi
# gedung tetangga ikut masuk. Itu pilihan yang aman untuk
# mulai; kalau nanti mau diperketat, jalankan
# scripts/analisa-radius.js untuk melihat sebaran jarak
# absensi yang sebenarnya.
RADIUS_METER=500
